# ============================================================================
# AERIS — environment variables reference
# Copy this file to the location you need and fill in real values.
# Never commit real secrets (see .gitignore).
# ============================================================================

# ---------------------------------------------------------------------------
# SIMULATOR  ->  simulator/.env
# ---------------------------------------------------------------------------
# Firebase project id (from Firebase Console > Project settings).
FIREBASE_PROJECT_ID=aeris978-e62b8

# Path to a Firebase service-account JSON key.
# Download it in Firebase Console > Project settings > Service accounts >
# "Generate new private key". The simulator uses the Admin SDK, which
# bypasses the Firestore security rules.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/aeris-service-account.json

# Optional: point the simulator at the local Firestore emulator instead of
# the hosted project (any non-empty value enables the emulator).
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# FRONTEND  ->  frontend/.env   (Vite only exposes VITE_-prefixed vars)
# ---------------------------------------------------------------------------
# All values come from Firebase Console > Project settings >
# "Your apps" > Web app > SDK setup and configuration (firebaseConfig).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — enables in-browser push notifications.
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# FUNCTIONS  ->  functions/.env (only used by the local emulator / shell)
# ---------------------------------------------------------------------------
# FCM topic that high/critical alerts are published to.
FCM_TOPIC=aeris-alerts