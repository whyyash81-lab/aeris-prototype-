# AERIS simulator config. Copy to simulator/.env and fill in real values.
# (dotenv loads this file when you run `npm run sim`.)

# Firebase project id (Firebase Console > Project settings).
FIREBASE_PROJECT_ID=aeris978-e62b8

# Path to a Firebase service-account JSON key.
# Firebase Console > Project settings > Service accounts > Generate new private key.
# The Admin SDK uses this to securely write readings (bypasses Firestore rules).
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/<you>/aeris-service-account.json

# Optional: run against the local Firestore emulator instead of the hosted
# project. Start it with:  firebase emulators:start --only firestore
# When set, no service-account key is required.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Optional tuning (seconds between a node's readings).
# READING_MIN_MS=3000
# READING_MAX_MS=5000